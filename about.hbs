<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licences</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 920px; margin: 2em auto; padding: 0 1em; line-height: 1.5; }
  pre { white-space: pre-wrap; background: #f3f4f6; padding: 1em; border-radius: 6px; font-size: 0.85em; }
  li { margin: 0.2em 0; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>sc-watch is built from these open-source libraries. Their licences follow.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}</ul>
<h2>Licences</h2>
{{#each licenses}}
<section>
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
